# microservice specific routes

->         /hmrc-frontend                           hmrcfrontend.Routes
GET        /assets/*file                            controllers.Assets.versioned(path = "/public", file: Asset)

GET   /                                             uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.IndexController.onPageLoad()



########################
# Manage an allow list
########################

GET   /manage/services/:service/allow-lists/:allowList                          uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.AllowListSummaryController.manage(service, allowList)

GET   /manage/services/:service/allow-lists/:allowList/change-status            uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.ToggleNewUserOnboardingController.onPageLoad(service: String, allowList: String)
POST  /manage/services/:service/allow-lists/:allowList/change-status            uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.ToggleNewUserOnboardingController.onSubmit(service: String, allowList: String)

GET   /manage/services/:service/allow-lists/:allowList/change-user-limit        uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SetUserLimitController.onPageLoad(service: String, allowList: String)
POST  /manage/services/:service/allow-lists/:allowList/change-user-limit        uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SetUserLimitController.onSubmit(service: String, allowList: String)

GET   /manage/services/:service/allow-lists/:allowList/set-percentage           uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SetPercentageLimitController.onPageLoad(service: String, allowList: String)
POST  /manage/services/:service/allow-lists/:allowList/set-percentage           uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SetPercentageLimitController.onSubmit(service: String, allowList: String)

GET   /manage/services/:service/allow-lists/:allowList/change-rolling-limit         uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SetRollingLimitController.onPageLoad(service, allowList, timeframe: Option[Timeframe] ?= None)
POST  /manage/services/:service/allow-lists/:allowList/change-rolling-limit         uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SetRollingLimitController.onSubmit(service, allowList, timeframe: Option[Timeframe] ?= None)

################################
# Dynamic Manage and View routes
################################
GET   /:mode/services/:service                               uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.ServiceSummaryController.onPageLoad(service, mode: UserMode)

################################
# View an allow list or service
################################

GET   /view/select-a-service                                uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SelectViewAllowListController.onPageLoad()
POST  /view/select-a-service                                uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SelectViewAllowListController.onSubmit()


GET   /view/services/:service/allow-lists/:allowList        uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.AllowListSummaryController.view(service, allowList)

# This URL is added for the reverse routes, it will not be reachable via request since the manage or view routes will match first
GET   /:mode/services/:service/allow-lists/:allowList             uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.AllowListSummaryController.root(service, allowList, mode: UserMode)

########################
# Create an allow list
########################

GET   /create/select-a-service                                          uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SelectCreateAllowListController.onPageLoad()
POST  /create/select-a-service                                          uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.SelectCreateAllowListController.onSubmit()

GET   /create/create-an-allow-list/:service                             uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.CreateAllowListController.onPageLoad(service: String)
POST  /create/create-an-allow-list/:service                             uk.gov.hmrc.ratelimitedallowlistadminfrontend.controllers.CreateAllowListController.onSubmit(service: String)
